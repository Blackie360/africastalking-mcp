{
  "name": "africastalking-mcp",
  "version": "0.2.0",
  "description": "Unofficial Africa\u2019s Talking MCP: stdio and encrypted multi-tenant hosted HTTP adapter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "africastalking-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "start": "node dist/src/index.js",
    "ussd": "node dist/examples/ussd-callback.js",
    "build:worker": "node scripts/build-worker.mjs",
    "test:oauth": "node --experimental-loader ./test/cloudflare-node-loader.mjs --test test/oauth-integration.mjs",
    "check:hosted": "npm run typecheck && npm run build && node --test dist/test/config.test.js dist/test/protocol.test.js dist/test/service.test.js dist/test/hosted.test.js dist/test/d1.test.js && npm run test:oauth && npm run build:worker"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
