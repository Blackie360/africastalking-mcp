# Safe defaults. A key is only needed for requests that reach Africa's Talking.
AT_ENVIRONMENT=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_ENABLE_MUTATIONS=false
AT_ENABLE_PRODUCTION=false
# Optional in sandbox; mandatory for production sends. Exact E.164 numbers only.
AT_ALLOWED_RECIPIENTS=
AT_MAX_RECIPIENTS=10
# Single configured currency; the cap is per API call, NOT a daily spend budget.
AT_AIRTIME_CURRENCY=KES
AT_MAX_AIRTIME_PER_REQUEST=100.00
AT_TIMEOUT_MS=15000
# Local example only. Never exposes a port unless explicitly started.
USSD_PORT=3000
